# Replace this secret before any deployment.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
DATABASE_URL=sqlite:///./smartbursary.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
ADMIN_EMAIL=admin@smartbursary.com
ADMIN_PASSWORD=ChangeMe123!

# Email settings (for local testing, use mailpit or similar)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@smartbursary.com
SMTP_FROM_NAME=SmartBursary System
EMAIL_ENABLED=true
